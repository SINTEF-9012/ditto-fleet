# Backend configuration — copy to .env and adjust as needed.
# All values below are the defaults used when a variable is unset.

# HTTP port of the backend API
PORT=4000

# MQTT broker for device communication (docker-compose-ditto.yml provides an authenticated one)
MQTT_BROKER=mqtt://test.mosquitto.org:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Eclipse Ditto gateway (host:port, no scheme)
DITTO_SERVER=localhost:8080
DITTO_USERNAME=ditto
DITTO_PASSWORD=ditto

# error | warn | info | debug
LOG_LEVEL=debug

# Software lifecycle service (softwareManagement feature)
# CSV file receiving lifecycle timing events; empty = no event log
SW_EVENT_LOG=
# Re-dispatch twins that have not converged every N ms (0 = disabled)
SW_RECONCILE_INTERVAL_MS=0
# A twin dispatched less than N ms ago is not re-dispatched by reconciliation
SW_STALE_AFTER_MS=30000
# Maximum number of concurrent HTTP requests to Ditto
SW_HTTP_CONCURRENCY=32

# Container-based trust-agent path (cyber.trustAgent). "off" disables its Ditto
# event streams and its periodic desired/reported check.
LEGACY_TRUST_AGENT=on
TRUST_AGENT_SYNC_CRON=*/2 * * * *
