REACT_APP_PROJECT=ENTRUST
DITTO_VERSION=3.9.7

# MQTT broker credentials for docker-compose-ditto.yml (lab defaults, not for production).
MQTT_USERNAME=lab
MQTT_PASSWORD=lab

# Ditto connection for the GUI (baked in at build time by CRA).
# Override locally in .env.local — do not commit real credentials.
REACT_APP_DITTO_DOMAIN=localhost:8080
REACT_APP_DITTO_USERNAME=ditto
REACT_APP_DITTO_PASSWORD=ditto
REACT_APP_DITTO_NAMESPACE=no.sintef.sct.giot
